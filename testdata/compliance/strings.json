{
  "tests": [
    {"name":"prefix present","expression":"startsWith(\"market:europe\",\"market:\")","result":true},
    {"name":"prefix absent","expression":"startsWith(\"market:europe\",\"domain:\")","result":false},
    {"name":"prefix case sensitive","expression":"startsWith(\"Market:\",\"market:\")","result":false},
    {"name":"empty prefix","expression":"startsWith(\"\",\"\")","result":true},
    {"name":"Unicode suffix","expression":"endsWith(\"hello世界\",\"世界\")","result":true},
    {"name":"suffix absent","expression":"endsWith(\"report.json\",\".csv\")","result":false},
    {"name":"empty suffix","expression":"endsWith(\"hello\",\"\")","result":true},
    {"name":"substring present","expression":"includes(\"application/json\",\"json\")","result":true},
    {"name":"substring absent","expression":"includes(\"application/json\",\"xml\")","result":false},
    {"name":"empty substring","expression":"includes(\"\",\"\")","result":true},
    {"name":"lower Unicode","expression":"lower(\"ÄBC世界\")","result":"äbc世界"},
    {"name":"upper Unicode","expression":"upper(\"äbc世界\")","result":"ÄBC世界"},
    {"name":"trim Unicode whitespace","expression":"trim(\"\\u2003 hello \\t\\n\")","result":"hello"},
    {"name":"trim preserves interior","expression":"trim(\" a b \")","result":"a b"},
    {"name":"nested normalization","expression":"lower(trim(\" APPROVED \")) == \"approved\"","result":true},
    {"name":"split delimiter","expression":"split(\"a,b,,c,\",\",\")","result":["a","b","","c",""]},
    {"name":"split unmatched delimiter","expression":"split(\"hello\",\",\")","result":["hello"]},
    {"name":"split empty text","expression":"split(\"\",\",\")","result":[""]},
    {"name":"split empty separator uses code points","expression":"split(\"世界😀\",\"\")","result":["世","界","😀"]},
    {"name":"split both empty","expression":"split(\"\",\"\")","result":[]},
    {"name":"join strings","expression":"join([\"a\",\"b\",\"\"],\",\")","result":"a,b,"},
    {"name":"join empty array","expression":"join([],\",\")","result":""},
    {"name":"join empty separator","expression":"join([\"世\",\"界\"],\"\")","result":"世界"},
    {"name":"join split round trip","expression":"join(split(\"a,b,c\",\",\"),\",\")","result":"a,b,c"},
    {"name":"map normalized values","expression":"[\" A \",\" B \"] | map item: lower(trim(item))","result":["a","b"]},
    {"name":"prefix invalid receiver","expression":"startsWith(1,\"1\")","error":"type","phase":"parse"},
    {"name":"prefix invalid needle","expression":"startsWith(\"1\",1)","error":"type","phase":"parse"},
    {"name":"suffix invalid receiver","expression":"endsWith(null,\"x\")","error":"type","phase":"parse"},
    {"name":"suffix invalid needle","expression":"endsWith(\"x\",absent)","error":"type","phase":"eval"},
    {"name":"includes is not array membership","expression":"includes([1],1)","error":"type","phase":"parse"},
    {"name":"includes invalid needle","expression":"includes(\"a\",null)","error":"type","phase":"parse"},
    {"name":"lower invalid","expression":"lower(true)","error":"type","phase":"parse"},
    {"name":"upper invalid","expression":"upper([])","error":"type","phase":"parse"},
    {"name":"trim missing","expression":"trim(absent)","error":"type","phase":"eval"},
    {"name":"split invalid text","expression":"split(null,\",\")","error":"type","phase":"parse"},
    {"name":"split invalid separator","expression":"split(\"a\",1)","error":"type","phase":"parse"},
    {"name":"join invalid array","expression":"join(\"ab\",\",\")","error":"type","phase":"parse"},
    {"name":"join invalid separator","expression":"join([],null)","error":"type","phase":"parse"},
    {"name":"join rejects numeric elements","expression":"join([\"a\",1],\",\")","error":"type","phase":"eval"},
    {"name":"join rejects missing elements","expression":"join([absent],\",\")","error":"type","phase":"eval"},
    {"name":"prefix arity","expression":"startsWith(\"x\")","error":"function","phase":"compile"},
    {"name":"suffix arity","expression":"endsWith()","error":"function","phase":"compile"},
    {"name":"includes arity","expression":"includes(\"a\",\"b\",\"c\")","error":"function","phase":"compile"},
    {"name":"lower arity","expression":"lower()","error":"function","phase":"compile"},
    {"name":"upper arity","expression":"upper(\"a\",\"b\")","error":"function","phase":"compile"},
    {"name":"trim arity","expression":"trim()","error":"function","phase":"compile"},
    {"name":"split arity","expression":"split(\"a\")","error":"function","phase":"compile"},
    {"name":"join arity","expression":"join([])","error":"function","phase":"compile"}
  ]
}
