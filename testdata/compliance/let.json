{
  "tests": [
    {"name":"single binding","expression":"let x=2:x*3","result":6},
    {"name":"multiple bindings","expression":"let x=2,y=3:x*y","result":6},
    {"name":"later value sees earlier","expression":"let x=2,y=x+1:y","result":3},
    {"name":"nested let","expression":"let x=1:let y=x+1:[x,y]","result":[1,2]},
    {"name":"shadow outer let","expression":"let x=1:let x=x+1:x","result":2},
    {"name":"shadow variable","expression":"let a=a+1:a","variables":{"a":1},"result":2},
    {"name":"this reaches shadowed variable","expression":"let a=0:this.a","variables":{"a":1},"result":1},
    {"name":"binds variable value","expression":"let n=input.n:n*n","variables":{"input":{"n":4}},"result":16},
    {"name":"object body","expression":"let x=1:{a:x,b:x+1}","result":{"a":1,"b":2}},
    {"name":"body is whole pipeline","expression":"let k=2:[1,2,3]|map v:v*k|filter v:v>2","result":[4,6]},
    {"name":"value is logical or","expression":"let x=false||true:x","result":true},
    {"name":"parenthesized pipeline value","expression":"let xs=([1,2]|map v:v*2):xs","result":[2,4]},
    {"name":"let in parentheses","expression":"1+(let x=2:x)","result":3},
    {"name":"let in stage body","expression":"[1,2]|map v:(let w=v*10:w+v)","result":[11,22]},
    {"name":"stage binding shadows let","expression":"let x=10:[1,2]|map x:x","result":[1,2]},
    {"name":"let in case arm","expression":"case{let x=1:x>0:\"pos\",\"neg\"}","result":"pos"},
    {"name":"let in object field","expression":"{a:let x=1:x+1}","result":{"a":2}},
    {"name":"let in array element","expression":"[let x=1:x,2]","result":[1,2]},
    {"name":"let in call argument","expression":"length(let s=\"ab\":s+s)","result":4},
    {"name":"missing value binds","expression":"let x=a?.b:x??7","result":7},
    {"name":"missing body","expression":"let x=1:absent","missing":true},
    {"name":"discarded binding","expression":"let _=1:2","result":2},
    {"name":"discarded value still evaluates","expression":"let _=1/0:2","error":"arithmetic","phase":"eval"},
    {"name":"value failure","expression":"let x=absent.field:1","error":"missing","phase":"eval"},
    {"name":"let as property name","expression":"this.let","variables":{"let":1},"result":1},
    {"name":"let as object key","expression":"{let:1}","result":{"let":1}},
    {"name":"bound type checked","expression":"let s=\"a\":s-1","error":"type","phase":"compile"},
    {"name":"later value type checked","expression":"let x=\"a\",y=x*2:y","error":"type","phase":"compile"},
    {"name":"shadowed type not checked","expression":"let x=1:[\"a\"]|map x:x+\"b\"","result":["ab"]},
    {"name":"let as operand","expression":"1+let x=2:x","error":"syntax","phase":"parse"},
    {"name":"let as stage body","expression":"[1]|map v:let w=v:w","error":"syntax","phase":"parse"},
    {"name":"let as binding name","expression":"let let=1:2","error":"syntax","phase":"parse"},
    {"name":"let as stage binding","expression":"[1]|map let:1","error":"syntax","phase":"parse"},
    {"name":"bare pipe in value","expression":"let x=[1]|map v:v:x","error":"syntax","phase":"parse"},
    {"name":"missing equals","expression":"let x:1","error":"syntax","phase":"parse"},
    {"name":"no body","expression":"let x=1","error":"syntax","phase":"parse"},
    {"name":"trailing comma","expression":"let x=1,:x","error":"syntax","phase":"parse"},
    {"name":"no bindings","expression":"let:1","error":"syntax","phase":"parse"},
    {"name":"no value","expression":"let x=:1","error":"syntax","phase":"parse"},
    {"name":"unknown function in value","expression":"let x=unknown():1","error":"function","phase":"compile"},
    {"name":"stage receiver type checked","expression":"(1-\"a\")|map x:x","error":"type","phase":"compile"},
    {"name":"single equals is not equality","expression":"1=1","error":"syntax","phase":"parse"}
  ]
}
