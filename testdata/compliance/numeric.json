    {"name":"sum empty","expression":"sum([])","result":0},
    {"name":"sum mapped numbers","expression":"sum([1,2,3] | map item:item*2)","result":12},
    {"name":"sum values","expression":"sum(values({a:2,b:3}))","result":5},
    {"name":"sum result arithmetic","expression":"sum([1,2])+4","result":7},
    {"name":"sum rejects nonarray","expression":"sum(1)","error":"type","phase":"eval"},
    {"name":"sum rejects string elements","expression":"sum([1,\"2\"])","error":"type","phase":"eval"},
    {"name":"sum rejects null elements","expression":"sum([null])","error":"type","phase":"eval"},
    {"name":"sum overflow","expression":"sum([1e308,1e308])","error":"arithmetic","phase":"eval"},
    {"name":"round positive tie","expression":"round(1.5)","result":2},
    {"name":"round negative tie","expression":"round(-1.5)","result":-2},
    {"name":"round smaller fraction","expression":"round(1.4)","result":1},
    {"name":"round numeric intermediate","expression":"round(1+0.5)","result":2},
    {"name":"floor negative","expression":"floor(-1.2)","result":-2},
    {"name":"ceil positive","expression":"ceil(1.2)","result":2},
    {"name":"floor computed","expression":"floor(1+0.5)","result":1},
    {"name":"ceil computed","expression":"ceil(1+0.5)","result":2},
    {"name":"round result arithmetic","expression":"round(1.5)+floor(2.9)+ceil(1.1)","result":6},
    {"name":"round rejects string","expression":"round(\"1\")","error":"type","phase":"eval"},
    {"name":"floor rejects bool","expression":"floor(false)","error":"type","phase":"eval"},
    {"name":"ceil rejects null","expression":"ceil(null)","error":"type","phase":"eval"},
    {"name":"sum arity","expression":"sum()","error":"function","phase":"compile"},
    {"name":"round arity","expression":"round(1,2)","error":"function","phase":"compile"},
    {"name":"floor arity","expression":"floor()","error":"function","phase":"compile"},
    {"name":"ceil arity","expression":"ceil()","error":"function","phase":"compile"}
  ]
