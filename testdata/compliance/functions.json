{
  "tests": [
    {"name":"empty string length","expression":"length(\"\")","result":0},
    {"name":"ASCII length","expression":"length(\"hello\")","result":5},
    {"name":"Unicode length","expression":"length(\"世界😀\")","result":3},
    {"name":"combining code points","expression":"length(\"é\")","result":2},
    {"name":"embedded null length","expression":"length(\"a\\u0000b\")","result":3},
    {"name":"empty array length","expression":"length([])","result":0},
    {"name":"array length","expression":"length([null,{},[]])","result":3},
    {"name":"missing array values count","expression":"length([absent,other])","result":2},
    {"name":"object length","expression":"length({a:1,b:2})","result":2},
    {"name":"empty object length","expression":"length({})","result":0},
    {"name":"omitted properties do not count","expression":"length({a:absent,b:null})","result":1},
    {"name":"absolute positive","expression":"abs(3)","result":3},
    {"name":"absolute negative","expression":"abs(-3)","result":3},
    {"name":"absolute computed","expression":"abs(1-3)","result":2},
    {"name":"minimum one argument","expression":"min(3)","result":3},
    {"name":"minimum variadic","expression":"min(3,-2,4,0)","result":-2},
    {"name":"maximum one argument","expression":"max(3)","result":3},
    {"name":"maximum variadic","expression":"max(3,-2,4,0)","result":4},
    {"name":"computed minimum","expression":"min(1+2,5-1)","result":3},
    {"name":"computed maximum","expression":"max(1+2,5-1)","result":4},
    {"name":"nested calls","expression":"max(abs(-5),min(1,2),length([1,2,3]))","result":5},
    {"name":"call trailing comma","expression":"max(1,2,)","result":2},
    {"name":"call result arithmetic","expression":"length([1,2])+abs(-3)","result":5},
    {"name":"call in collection","expression":"[\"a\",\"abc\"] | map item:length(item)","result":[1,3]},
    {"name":"input variable named like builtin","expression":"length.value","variables":{"length":{"value":7}},"result":7},
    {"name":"named builtin independent of variable","expression":"length([1,2])","variables":{"length":7},"result":2},
    {"name":"length number","expression":"length(1)","error":"type","phase":"parse"},
    {"name":"length computed number","expression":"length(1+2)","error":"type","phase":"parse"},
    {"name":"length missing","expression":"length(absent)","error":"type","phase":"eval"},
    {"name":"abs string","expression":"abs(\"1\")","error":"type","phase":"parse"},
    {"name":"abs missing","expression":"abs(absent)","error":"type","phase":"eval"},
    {"name":"min invalid first","expression":"min(true,1)","error":"type","phase":"parse"},
    {"name":"min invalid later","expression":"min(1,true)","error":"type","phase":"parse"},
    {"name":"max invalid first","expression":"max(null,1)","error":"type","phase":"parse"},
    {"name":"max invalid later","expression":"max(1,\"2\")","error":"type","phase":"parse"},
    {"name":"length no arguments","expression":"length()","error":"function","phase":"compile"},
    {"name":"length excess arguments","expression":"length([],[])","error":"function","phase":"compile"},
    {"name":"abs no arguments","expression":"abs()","error":"function","phase":"compile"},
    {"name":"abs excess arguments","expression":"abs(1,2)","error":"function","phase":"compile"},
    {"name":"min no arguments","expression":"min()","error":"function","phase":"compile"},
    {"name":"max no arguments","expression":"max()","error":"function","phase":"compile"},
    {"name":"unknown named function","expression":"unknown(1)","error":"function","phase":"compile"},
    {"name":"unknown skipped case","expression":"case{true:1,unknown()}","error":"function","phase":"compile"},
    {"name":"unknown skipped and","expression":"false&&unknown()","error":"function","phase":"compile"},
    {"name":"unknown skipped or","expression":"true||unknown()","error":"function","phase":"compile"},
    {"name":"unknown skipped coalesce","expression":"1??unknown()","error":"function","phase":"compile"},
    {"name":"unknown skipped index","expression":"null?.[unknown()]","error":"function","phase":"compile"},
    {"name":"unknown empty map","expression":"[] | map item:unknown()","error":"function","phase":"compile"},
    {"name":"unknown empty filter","expression":"[] | filter item:unknown()","error":"function","phase":"compile"},
    {"name":"invalid arity in skipped branch","expression":"case{false:abs(),1}","error":"function","phase":"compile"}
