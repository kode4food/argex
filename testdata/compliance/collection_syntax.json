    {"name":"operation whitespace","expression":"[1,2] | filter item : item > 1","result":[2]},
    {"name":"operation newline","expression":"[1,2]\n|\nmap\nitem\n:\nitem+1","result":[2,3]},
    {"name":"operation without spaces","expression":"[1,2]|filter item:item>1","result":[2]},
    {"name":"property names are ordinary paths","expression":"value.map.filter.any.all","variables":{"value":{"map":{"filter":{"any":{"all":7}}}}},"result":7},
    {"name":"optional property names","expression":"value?.map?.filter","variables":{"value":{"map":{"filter":7}}},"result":7},
    {"name":"optional missing property","expression":"value?.map?.filter ?? 7","variables":{"value":null},"result":7},
    {"name":"property followed by operation","expression":"value.map | filter item: item>1","variables":{"value":{"map":[1,2]}},"result":[2]},
    {"name":"filter property followed by map","expression":"value.filter | map item: item+1","variables":{"value":{"filter":[1,2]}},"result":[2,3]},
    {"name":"bracket property followed by operation","expression":"value[\"any\"] | map item: item+1","variables":{"value":{"any":[1,2]}},"result":[2,3]},
    {"name":"optional access before operation","expression":"value?.items | map item: item+1","variables":{"value":{"items":[1,2]}},"result":[2,3]},
    {"name":"optional access inside body","expression":"[{}, {map:2}] | map item: item?.map ?? 0","result":[0,2]},
    {"name":"coalesce before operation","expression":"(absent ?? [1]) | map item: item+1","result":[2]},
    {"name":"optional collection default","expression":"(value?.items ?? []) | map item: item.id","variables":{"value":null},"result":[]},
    {"name":"operation names as bindings","expression":"[{map:1}] | map filter: filter.map","result":[1]},
    {"name":"explicit operation composition","expression":"([1,2] | filter item: item>1) | map item: item+1","result":[3]},
    {"name":"ungrouped operation stays in body","expression":"[1,2] | filter item: item>1 | map item: item","error":"type","phase":"eval"},
    {"name":"OR in map body","expression":"[false,true] | map item: item || false","result":[false,true]},
    {"name":"OR in filter body","expression":"[false,true]|filter item:item||false","result":[true]},
    {"name":"OR outside operation","expression":"false || 1 in ([1] | map item: item)","result":true},
    {"name":"OR short circuits operation","expression":"true || ([1] | map item: 1/0) == []","result":true},
    {"name":"old map invocation rejected","expression":"[1].map item: item","error":"syntax","phase":"parse"},
    {"name":"old filter invocation rejected","expression":"[1].filter item: true","error":"syntax","phase":"parse"},
    {"name":"unknown operation","expression":"[1] | unknown item: item","error":"syntax","phase":"parse"},
    {"name":"bare pipe","expression":"[1]|","error":"syntax","phase":"parse"},
    {"name":"pipe before property dot","expression":"[1] | .map item: item","error":"syntax","phase":"parse"},
    {"name":"missing binding","expression":"[1] | map","error":"syntax","phase":"parse"},
    {"name":"unknown empty operation","expression":"[] | reduce item: true","error":"syntax","phase":"parse"},
    {"name":"question map rejected","expression":"[1]?map item: item","error":"syntax","phase":"parse"},
    {"name":"question filter rejected","expression":"[1]?filter item: true","error":"syntax","phase":"parse"},
    {"name":"OR is not a collection separator","expression":"[1] || map item: item","error":"syntax","phase":"parse"},
    {"name":"no bitwise OR","expression":"1 | 2","error":"syntax","phase":"parse"},
    {"name":"no ternary","expression":"true ? 1 : 2","error":"syntax","phase":"parse"},
    {"name":"optional access does not make map optional","expression":"value?.items | map item: item","variables":{"value":null},"error":"type","phase":"eval"},
    {"name":"array index binding","expression":"[10,20] | map i, v: [i, v]","result":[[0,10],[1,20]]},
    {"name":"array key binding ignores value name collision","expression":"[5,6] | map i, i: i","result":[0,1]},
    {"name":"object key value binding","expression":"{a:1,b:2} | map k, v: k","result":["a","b"]},
    {"name":"object value binding","expression":"{b:2,a:1} | map k, v: v","result":[1,2]},
