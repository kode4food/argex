{
  "tests": [
    {"name":"sorted keys","expression":"keys({z:1,a:2,m:3})","result":["a","m","z"]},
    {"name":"sorted values","expression":"values({z:1,a:2,m:3})","result":[2,3,1]},
    {"name":"lexical numeric keys","expression":"keys({\"2\":2,\"10\":10})","result":["10","2"]},
    {"name":"empty keys","expression":"keys({})","result":[]},
    {"name":"empty values","expression":"values({})","result":[]},
    {"name":"values preserve null and objects","expression":"values({a:null,b:{x:1}})","result":[null,{"x":1}]},
    {"name":"omitted field has no key","expression":"keys({a:absent,b:null})","result":["b"]},
    {"name":"computed key","expression":"{[k]: 1}","variables":{"k":"a"},"result":{"a":1}},
    {"name":"computed key expression","expression":"{[\"x\" + string(n)]: n}","variables":{"n":2},"result":{"x2":2}},
    {"name":"computed key after fields","expression":"{a: 1, [k]: 2, b: 3}","variables":{"k":"c"},"result":{"a":1,"b":3,"c":2}},
    {"name":"computed key overrides earlier","expression":"{a: 1, [k]: 2}","variables":{"k":"a"},"result":{"a":2}},
    {"name":"literal key overrides earlier computed","expression":"{[k]: 1, boom: 2}","variables":{"k":"boom"},"result":{"boom":2}},
    {"name":"literal key after spread and computed","expression":"{...o, [k]: 1, boom: 2}","variables":{"o":{},"k":"boom"},"result":{"boom":2}},
    {"name":"computed key omits missing value","expression":"keys({[k]: absent})","variables":{"k":"a"},"result":[]},
    {"name":"constant computed key","expression":"{[\"a\"]: 1}","result":{"a":1}},
    {"name":"constant computed key duplicate","expression":"{a: 1, [\"a\"]: 2}","error":"syntax","phase":"parse"},
    {"name":"computed key in comprehension","expression":"[\"a\",\"b\"] | map i, k: {[k]: i}","result":[{"a":0},{"b":1}]},
    {"name":"computed key rejects number","expression":"{[1]: 1}","error":"type","phase":"parse"},
    {"name":"computed key rejects null","expression":"{[null]: 1}","error":"type","phase":"parse"},
    {"name":"computed key rejects missing","expression":"{[absent]: 1}","error":"type","phase":"eval"},
    {"name":"computed key unclosed","expression":"{[k: 1}","error":"syntax","phase":"parse"},
    {"name":"computed key empty","expression":"{[]: 1}","error":"syntax","phase":"parse"},
    {"name":"computed key unknown function","expression":"{[nope()]: 1}","error":"function","phase":"compile"},
    {"name":"computed key needs colon","expression":"{[k]}","error":"syntax","phase":"parse"},
    {"name":"keys reject array","expression":"keys([])","error":"type","phase":"parse"},
    {"name":"values reject null","expression":"values(null)","error":"type","phase":"parse"},
    {"name":"keys arity","expression":"keys()","error":"function","phase":"compile"},
    {"name":"values arity","expression":"values({}, {})","error":"function","phase":"compile"}
  ]
}
