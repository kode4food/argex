expression     = pipeline ;
pipeline       = logicalOr, { "|", operation, [ binding ], logicalOr } ;
operation      = "map" | "filter" | "any" | "all" ;
binding        = identifier, [ ",", identifier ], ":" ;
logicalOr      = logicalAnd, { "||", logicalAnd } ;
logicalAnd     = coalesce, { "&&", coalesce } ;
coalesce       = equality, [ "??", coalesce ] ;
equality       = comparison, { ("==" | "!="), comparison } ;
comparison     = additive, [ ("<" | "<=" | ">" | ">=" | "in"), additive ] ;
additive       = multiplicative, { ("+" | "-"), multiplicative } ;
multiplicative = unary, { ("*" | "/" | "%"), unary } ;
unary          = ("!" | "+" | "-"), unary | postfix ;

postfix        = primary, { access | call } ;
access         = ".", identifier
               | "?.", identifier
               | "[", expression, "]"
               | "?.", "[", expression, "]" ;
call           = "(", [ arguments ], ")" ;
arguments      = expression, { ",", expression }, [ "," ] ;

primary        = literal | identifier | "this" | "(", expression, ")"
               | array | object | case ;
array          = "[", [ element, { ",", element }, [ "," ] ], "]" ;
element        = [ "..." ], expression ;
object         = "{", [ member, { ",", member }, [ "," ] ], "}" ;
member         = field | "...", expression ;
field          = (identifier | string | "[", expression, "]"), ":",
                 expression ;
case           = "case", "{", arm, { ",", arm },
                 ",", expression, [ "," ], "}" ;
arm            = expression, ":", expression ;
literal        = number | string | "true" | "false" | "null" ;

(* Terminals: number is an unsigned JSON number (signs are unary operators);
   string is a double-quoted JSON string; identifier is a Unicode letter or
   underscore followed by letters, digits, or underscores. true, false, null,
   case, and this are reserved as variable and binding names but remain valid
   property names and object keys; in is contextual and also a valid
   identifier. this is the program's input.
   Whitespace is ignored between tokens and operators use longest match.
   The pipe is the lowest-precedence operator and chains left to right; a
   stage body is a logicalOr, so a nested pipeline needs parentheses.
   A binding is recognized only as "name:" or "name, name:". A binding name
   of _ binds nothing. Each stage body also sees the bindings of the earlier
   stages in its pipeline. *)
