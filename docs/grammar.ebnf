expression     = logicalOr ;
logicalOr      = logicalAnd, { "||", logicalAnd } ;
logicalAnd     = coalesce, { "&&", coalesce } ;
coalesce       = equality, [ "??", coalesce ] ;
equality       = comparison, { ("==" | "!="), comparison } ;
comparison     = additive, [ ("<" | "<=" | ">" | ">=" | "in"), additive ] ;
additive       = multiplicative, { ("+" | "-"), multiplicative } ;
multiplicative = unary, { ("*" | "/" | "%"), unary } ;
unary          = ("!" | "+" | "-"), unary | postfix ;

postfix        = primary, { access | call }, [ collection ] ;
access         = ".", identifier
               | "?.", identifier
               | "[", expression, "]"
               | "?.", "[", expression, "]" ;
call           = "(", [ arguments ], ")" ;
arguments      = expression, { ",", expression }, [ "," ] ;
collection     = "|", ("map" | "filter"), binding ;
binding        = identifier, ":", expression ;

primary        = literal | identifier | "(", expression, ")"
               | array | object | case ;
array          = "[", [ arguments ], "]" ;
object         = "{", [ field, { ",", field }, [ "," ] ], "}" ;
field          = (identifier | string), ":", expression ;
case           = "case", "{", arm, { ",", arm },
                 ",", expression, [ "," ], "}" ;
arm            = expression, ":", expression ;
literal        = number | string | "true" | "false" | "null" ;

(* number: unsigned JSON number; signs are unary operators.
   string: double-quoted JSON string.
   identifier: Unicode letter or underscore followed by letters, digits,
   or underscores. true, false, null, and case are reserved as bindings.
   in is a contextual operator between expressions; it remains a valid name.
   Whitespace is ignored between tokens. Operators use longest match.
   | introduces a collection operation; . and ?. access properties.
   Calls require a named function as their receiver.
   Duplicate object keys are invalid. A case requires a final fallback. *)
